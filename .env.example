# SATMAT Environment Configuration
# Copy this file to .env.local (web) / .env (backend) and fill in your values.
# NEVER commit real .env / .env.local files to version control.

# ---- Web app (Next.js) ----
# API_BASE_URL is PRIVATE (server-side only). It is read by next.config.ts
# rewrites to proxy /api/v1/* → backend. The browser never sees this URL.
# The client (src/lib/api.ts) uses same-origin requests ("/api/v1") and the
# Next.js server forwards them to API_BASE_URL. CSP only allows 'self'.
API_BASE_URL="https://satmat-backendfinal.onrender.com"

# Optional: NEXT_PUBLIC_API_BASE_URL. Only set this if you want the browser
# to call a specific cross-origin backend directly (skipping the proxy).
# Leave UNSET in production so the backend URL stays out of the bundle.
# NEXT_PUBLIC_API_BASE_URL="https://satmat-backendfinal.onrender.com"

# ---- Vercel Deployment ----
# Set API_BASE_URL in the Vercel dashboard Project Settings > Environment
# Variables to: https://satmat-backendfinal.onrender.com
# Leave NEXT_PUBLIC_API_BASE_URL UNSET (do not create it).

# ---- Backend (backend/.env) ----
# See backend/.env.example for the full list. Required keys:
# DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET, CORS_ORIGINS, APP_URL
# Optional: PAYMENT_PROVIDER, SMS_PROVIDER, PUSH_PROVIDER (mock by default),
# GEMINI_API_KEY for the AI support chat.
